APP_NAME=NexusAI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://nexusai:nexusai_dev_password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379/0
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
UPLOAD_DIRECTORY=data/uploads
MAX_UPLOAD_SIZE_MB=50
MAX_URL_RESPONSE_SIZE_MB=10
URL_CONNECT_TIMEOUT_SECONDS=5
URL_READ_TIMEOUT_SECONDS=20
URL_MAX_REDIRECTS=5
CRAWLER_USER_AGENT=NexusAIKnowledgeBot/0.2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENAI_API_KEY=
VECTOR_TOP_K=20
BM25_TOP_K=20
HYBRID_TOP_K=10
RRF_K=60
RERANKER_PROVIDER=fake
RERANKER_MODEL=rerank-v3.5
RERANK_TOP_K=5
COHERE_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
RAG_MAX_CONTEXT_TOKENS=6000
QUERY_CACHE_TTL_SECONDS=3600
MIN_RECALL_AT_5=0.5
MIN_MRR=0.4
AGENT_MAX_STEPS=10
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_RETRIES=2
AGENT_TOOL_RETRIES=1
AGENT_CONVERSATION_WINDOW=10
SQL_TOOL_MAX_ROWS=100
SQL_TOOL_TIMEOUT_SECONDS=10
SQL_TOOL_ALLOWED_SCHEMAS=public
SQL_TOOL_ALLOWED_TABLES=
HTTP_TOOL_ALLOWED_HOSTS=
HTTP_TOOL_TIMEOUT_SECONDS=15
HTTP_TOOL_MAX_RESPONSE_BYTES=1048576
WEB_SEARCH_PROVIDER=fake
TAVILY_API_KEY=
DATA_SQL_MAX_RETRIES=2
